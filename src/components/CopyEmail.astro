---
import { site } from "../data/site";
---

<!-- mailto does nothing useful for anyone whose mail lives in a browser tab, so
     the address can be copied as well. Hidden until the script confirms the
     clipboard is there to write to. -->
<button
  type="button"
  data-copy-email={site.email}
  hidden
  class="copy-email inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-medium transition hover:border-brass hover:text-brass"
>
  <svg
    class="size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="8.5" y="8.5" width="12" height="12" rx="2.2"></rect>
    <path d="M15.5 8.5V5.7a2.2 2.2 0 0 0-2.2-2.2H5.7a2.2 2.2 0 0 0-2.2 2.2v7.6a2.2 2.2 0 0 0 2.2 2.2h2.8"></path>
  </svg>
  <span data-copy-label>Copy email</span>
</button>
<span class="sr-only" aria-live="polite" data-copy-status></span>

<script>
  if (navigator.clipboard && window.isSecureContext) {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((btn) => {
      const label = btn.querySelector("[data-copy-label]");
      const status = btn.nextElementSibling;
      const resting = label?.textContent ?? "";
      let timer = 0;
      btn.hidden = false;

      btn.addEventListener("click", async () => {
        let message = "Copied";
        try {
          await navigator.clipboard.writeText(btn.dataset.copyEmail ?? "");
        } catch {
          message = "Copy failed";
        }
        if (label) label.textContent = message;
        if (status) status.textContent = message === "Copied" ? "Email address copied" : message;
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (label) label.textContent = resting;
          if (status) status.textContent = "";
        }, 2000);
      });
    });
  }
</script>
