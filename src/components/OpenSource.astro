---
import { packages } from "../data/site";

// npm is asked once per package at build time. If it is unreachable the section
// still renders, just without the number: a missing figure beats a failed build.
async function downloads(pkg: string): Promise<number | null> {
  const url = `https://api.npmjs.org/downloads/point/last-month/@tunghtml%2Fstrapi-plugin-${pkg}`;
  try {
    const r = await fetch(url, { signal: AbortSignal.timeout(8000) });
    if (!r.ok) return null;
    const j = await r.json();
    return typeof j.downloads === "number" ? j.downloads : null;
  } catch {
    return null;
  }
}

const list = await Promise.all(
  packages.map(async (p) => ({ ...p, downloads: await downloads(p.name) })),
);

const total = list.reduce((sum, p) => sum + (p.downloads ?? 0), 0);
const fmt = new Intl.NumberFormat("en-GB");
---

<section id="open-source" class="mx-auto max-w-5xl px-6 py-20">
  <div class="reveal flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="eyebrow">Open source</h2>
    {total > 0 && <span class="eyebrow">{fmt.format(total)} installs a month</span>}
  </div>

  <p class="reveal mt-6 max-w-2xl leading-relaxed text-muted">
    Editors kept asking for fields Strapi does not ship, so I wrote them. Seven plugins on npm,
    maintained rather than published and abandoned.
  </p>

  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
    {
      list.map((p, i) => (
        <li class="reveal" style={`transition-delay: ${i * 50}ms`}>
          <a
            href={`https://www.npmjs.com/package/@tunghtml/strapi-plugin-${p.name}`}
            target="_blank"
            rel="noopener"
            class="group flex h-full flex-col rounded-xl border border-border bg-surface p-5 transition-colors hover:border-brass/60"
          >
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-mono text-sm transition-colors group-hover:text-brass">{p.name}</h3>
              {p.downloads !== null && (
                <span class="eyebrow shrink-0">{fmt.format(p.downloads)}/mo</span>
              )}
            </div>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.blurb}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
