---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.intro } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#120e1a" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      document.documentElement.classList.add("js");
      const saved = localStorage.getItem("theme");
      if (saved) document.documentElement.dataset.theme = saved;
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:ring-2 focus:ring-brass"
      >Skip to content</a
    >

    <header class="sticky top-0 z-40 border-b border-border/60 bg-bg/80 backdrop-blur-md">
      <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6" aria-label="Main">
        <a href="/" class="font-display text-base font-bold tracking-tight hover:text-brass">
          LNT<span class="text-brass">.</span>
        </a>

        <div class="flex items-center gap-6 text-sm">
          <a href="/#work" class="text-muted transition-colors hover:text-text">Work</a>
          <a href="/#about" class="hidden text-muted transition-colors hover:text-text sm:inline"
            >About</a
          >
          <a href="/#contact" class="text-muted transition-colors hover:text-text">Contact</a>

          <button
            id="theme-toggle"
            type="button"
            class="grid size-8 place-items-center rounded-full border border-border text-muted transition hover:border-brass hover:text-brass"
            aria-label="Switch between light and dark"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            >
              <circle cx="12" cy="12" r="4.2"></circle>
              <path
                d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"
              ></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-28 border-t border-border/60">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-9 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="font-mono text-xs">© {new Date().getFullYear()} {site.name}</p>
        <div class="flex gap-5">
          {
            site.socials.map((s) => (
              <a
                href={s.href}
                class="transition-colors hover:text-brass"
                rel="me noopener"
                target="_blank"
              >
                {s.label}
              </a>
            ))
          }
        </div>
      </div>
    </footer>

    <script is:inline>
      const root = document.documentElement;
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const current =
          root.dataset.theme ||
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>

    <script>
      // Sections settle in as they come into view. Two safety nets, because a
      // section that never shows up is far worse than one that animates late:
      //   1. anything at or above the fold on load is shown immediately, so a
      //      #hash link that jumps down the page does not strand what it skipped;
      //   2. a scroll pass catches elements the observer missed when the page is
      //      scrolled faster than it can report intersections.
      const items = new Set(document.querySelectorAll(".reveal"));
      if (items.size) {
        const show = (el) => {
          el.classList.add("is-in");
          items.delete(el);
          io.unobserve(el);
        };

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) if (e.isIntersecting) show(e.target);
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.06 },
        );

        const sweep = () => {
          for (const el of items) {
            if (el.getBoundingClientRect().top < window.innerHeight) show(el);
          }
        };

        let queued = false;
        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            sweep();
            if (!items.size) window.removeEventListener("scroll", onScroll);
          });
        };

        requestAnimationFrame(() => {
          sweep();
          items.forEach((el) => io.observe(el));
          window.addEventListener("scroll", onScroll, { passive: true });
        });
      }
    </script>
  </body>
</html>
