---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page does not exist, or it moved.">
  <section class="canvas-grid border-b border-border">
    <div class="mx-auto max-w-5xl px-6 pt-20 pb-24 sm:pt-28 sm:pb-32">
      <p class="eyebrow rise">Error 404</p>
      <h1
        class="rise mt-5 pb-[0.06em] font-display text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.04] font-extrabold tracking-[-0.03em]"
        style="animation-delay: 100ms"
      >
        Nothing on this layer.
      </h1>
      <p class="rise mt-6 max-w-xl text-lg leading-relaxed text-muted" style="animation-delay: 200ms">
        The page you were after does not exist, or it has moved. Everything I have shipped is still
        on the home page.
      </p>

      <div class="rise mt-9 flex flex-wrap items-center gap-3" style="animation-delay: 300ms">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-full bg-brass px-5 py-2.5 text-sm font-medium text-bg transition hover:bg-brass-bright"
        >
          <span aria-hidden="true">←</span>
          Back to the home page
        </a>
        <a
          href="/#work"
          class="rounded-full border border-border px-5 py-2.5 text-sm font-medium transition hover:border-brass hover:text-brass"
        >
          See the work
        </a>
      </div>
    </div>
  </section>
</Base>
