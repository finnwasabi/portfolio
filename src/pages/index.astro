---
import { getCollection } from "astro:content";
import CopyEmail from "../components/CopyEmail.astro";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import WorkCard from "../components/WorkCard.astro";
import Toolbox from "../components/Toolbox.astro";
import Marquee from "../components/Marquee.astro";
import OpenSource from "../components/OpenSource.astro";
import Testimonials from "../components/Testimonials.astro";
import { site, focus, experience, education, homelab, retainer, highlights } from "../data/site";

const all = (await getCollection("work", ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);
const work = all.filter((entry) => !entry.data.personal);
const featured = highlights.map((h) => ({
  ...h,
  entry: all.find((entry) => entry.id === h.slug)!,
}));

const usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
const inquiry = `mailto:${site.email}?subject=${encodeURIComponent(retainer.inquiry.subject)}&body=${encodeURIComponent(retainer.inquiry.body)}`;
const personal = all.filter((entry) => entry.data.personal);

// Filters are the stack tags shared by at least two projects, most used first.
// A tag on one project would filter down to a single card, which a scroll does better.
const tagCounts = new Map<string, number>();
for (const entry of work) {
  for (const tag of entry.data.stack) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const filters = [...tagCounts]
  .filter(([, n]) => n > 1)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);
---

<Base>
  <Hero />

  <Marquee
    items={["Front-end", "Strapi plugins", "Design systems", "Performance", "Accessibility"]}
  />

  {/* Case studies, short form. Each row restates its full case study. */}
  <section id="case-studies" class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="eyebrow reveal">Case studies</h2>
    <div class="mt-8 grid gap-6">
      {
        featured.map(({ entry, context, problem, did, result }, i) => (
          <article
            class="reveal rounded-2xl border border-border bg-surface p-7 sm:p-8"
            style={`transition-delay: ${i * 90}ms`}
            aria-labelledby={`case-${entry.id}`}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 id={`case-${entry.id}`} class="font-display text-xl font-bold tracking-tight">
                {entry.data.title}
              </h3>
              <p class="eyebrow">
                {context} · {entry.data.period}
              </p>
            </div>
            <dl class="mt-6 grid gap-6 sm:grid-cols-3">
              {[
                ["Problem", problem],
                ["What I did", did],
                ["Result", result],
              ].map(([term, body]) => (
                <div>
                  <dt class="eyebrow">{term}</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-muted">{body}</dd>
                </div>
              ))}
            </dl>
            <a
              href={`/work/${entry.id}/`}
              class="mt-6 inline-flex items-center gap-2 text-sm font-medium transition-colors hover:text-brass"
            >
              Read the case study<span class="sr-only">: {entry.data.title}</span>
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <OpenSource />

  {/* Work with me */}
  <section id="work-with-me" class="mx-auto max-w-5xl px-6 py-20">
    <div class="reveal flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="eyebrow">Work with me</h2>
      <p class="eyebrow inline-flex items-center gap-2">
        <span class="availability-dot" aria-hidden="true"></span>
        <span class="text-brass">{retainer.availability}</span>
      </p>
    </div>
    <p class="reveal mt-6 leading-relaxed text-muted">
      A set number of hours each month, on a monthly retainer. {retainer.timezone}.
    </p>

    <ul class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        retainer.plans.map((plan, i) => (
          <li
            class="reveal rounded-xl border border-border bg-surface p-6"
            style={`transition-delay: ${i * 70}ms`}
          >
            <p class="eyebrow">{plan.hours} hours a month</p>
            <p class="mt-3 font-display text-3xl font-extrabold tracking-tight tabular-nums">
              {usd.format(plan.price)}
              <span class="font-sans text-sm font-normal text-muted"> / month</span>
            </p>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 grid gap-10 sm:grid-cols-2">
      <div class="reveal">
        <h3 class="font-display text-lg font-bold tracking-tight">Every plan includes</h3>
        <div class="mt-3 h-px w-10 bg-brass"></div>
        <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-muted">
          {
            retainer.included.map((item) => (
              <li class="relative pl-5 before:absolute before:top-2.5 before:left-0 before:h-px before:w-3 before:bg-brass">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal">
        <h3 class="font-display text-lg font-bold tracking-tight">Terms</h3>
        <div class="mt-3 h-px w-10 bg-brass"></div>
        <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-muted">
          {
            retainer.terms.map((item) => (
              <li class="relative pl-5 before:absolute before:top-2.5 before:left-0 before:h-px before:w-3 before:bg-brass">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="reveal mt-10 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a
        href={inquiry}
        class="inline-flex items-center gap-2 rounded-full bg-brass px-5 py-2.5 text-sm font-medium text-bg transition hover:bg-brass-bright"
      >
        Start a retainer inquiry
        <span aria-hidden="true">→</span>
      </a>
      <p class="text-sm text-muted">
        Opens an email to {site.email} asking for your team size, stack and hours per month.
      </p>
    </div>
  </section>

  {/* What I work on */}
  <section class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="eyebrow reveal">What I work on</h2>
    <div class="mt-8 grid gap-10 sm:grid-cols-3">
      {
        focus.map((f, i) => (
          <div class="reveal" style={`transition-delay: ${i * 90}ms`}>
            <h3 class="font-display text-lg font-bold tracking-tight">{f.title}</h3>
            <div class="mt-3 h-px w-10 bg-brass" />
            <p class="mt-3 text-sm leading-relaxed text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* Work */}
  <section id="work" class="mx-auto max-w-5xl px-6 py-12">
    <div class="reveal flex items-baseline justify-between">
      <h2 class="eyebrow">Selected work</h2>
      <span class="eyebrow" id="work-count" aria-live="polite">{work.length} projects</span>
    </div>

    {/* Only shown once the script is running: without it every card is already
         visible, and buttons that do nothing would be worse than no buttons. */}
    <div
      id="work-filters"
      class="work-filters reveal mt-6 flex flex-wrap gap-2"
      role="group"
      aria-label="Filter projects by stack"
    >
      {
        ["All", ...filters].map((tag, i) => (
          <button
            type="button"
            data-filter={i === 0 ? "" : tag}
            aria-pressed={i === 0 ? "true" : "false"}
            class="rounded-full border border-border px-3 py-1 font-mono text-[11px] tracking-wide text-muted transition-colors hover:border-brass/60 hover:text-text aria-pressed:border-brass aria-pressed:bg-brass aria-pressed:text-bg"
          >
            {tag}
          </button>
        ))
      }
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2" id="work-grid">
      {work.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </section>

  {
    personal.length > 0 && (
      <section id="personal" class="mx-auto max-w-5xl px-6 py-12">
        <h2 class="eyebrow reveal">Personal projects</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {personal.map((entry, i) => <WorkCard entry={entry} index={i} />)}
        </div>
      </section>
    )
  }

  {/* Experience */}
  <section id="about" class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="eyebrow reveal">Experience</h2>

    <div class="mt-8 grid gap-10">
      {
        experience.map((job, i) => (
          <div
            class="reveal grid gap-3 border-t border-border pt-6 sm:grid-cols-[11rem_1fr] sm:gap-8"
            style={`transition-delay: ${i * 90}ms`}
          >
            <div>
              <p class="eyebrow">{job.period}</p>
              <h3 class="mt-1.5 font-display text-lg font-bold tracking-tight">{job.company}</h3>
              <p class="text-sm text-muted">{job.role}</p>
            </div>
            <ul class="grid gap-2 text-sm leading-relaxed text-muted">
              {job.points.map((p) => (
                <li class="relative pl-5 before:absolute before:top-2.5 before:left-0 before:h-px before:w-3 before:bg-brass">
                  {p}
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      {
        education.map((school, i) => (
          <div class="reveal grid gap-3 border-t border-border pt-6 sm:grid-cols-[11rem_1fr] sm:gap-8">
            <div>
              <p class="eyebrow">{school.period}</p>
              {/* The heading names the section once; the second entry just continues it */}
              {i === 0 && (
                <h3 class="mt-1.5 font-display text-lg font-bold tracking-tight">Education</h3>
              )}
            </div>
            <div class="text-sm leading-relaxed text-muted">
              <p class="text-text">{school.school}</p>
              <p class="mt-1">{school.major}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-16">
      <h2 class="eyebrow reveal">Tools</h2>
      <div class="mt-5">
        <Toolbox />
      </div>
    </div>
  </section>

  <Testimonials />

  {/* Outside work */}
  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="reveal rounded-2xl border border-border bg-surface p-8 sm:p-10">
      <h2 class="eyebrow">{homelab.title}</h2>
      {/* Runs the full width of the card on purpose, so the paragraph and the
           stats row below it share one edge instead of ending 300px apart. */}
      <p class="mt-4 leading-relaxed text-muted">{homelab.body}</p>

      <dl class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {
          homelab.stats.map(([value, label]) => (
            <div>
              <dt class="font-display text-2xl font-extrabold tracking-tight text-brass tabular-nums">
                {value}
              </dt>
              <dd class="mt-1 text-xs text-muted">{label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Contact */}
  <section id="contact" class="mx-auto max-w-5xl px-6 pb-8">
    <div
      class="reveal canvas-grid relative overflow-hidden rounded-3xl border border-border bg-surface p-10 sm:p-14"
    >
      <div
        class="pointer-events-none absolute -right-24 -bottom-28 size-72 rounded-full opacity-50 blur-[80px]"
        style="background: radial-gradient(circle, color-mix(in oklab, var(--plum) 40%, transparent), transparent 70%)"
      >
      </div>

      <h2 class="font-display text-3xl font-extrabold tracking-tight sm:text-4xl">Get in touch</h2>
      <p class="mt-4 leading-relaxed text-muted">
        Questions about anything here, or just want to talk shop about front-end work? Write to me. I
        reply to everything, usually within a day.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 rounded-full bg-brass px-5 py-2.5 text-sm font-medium text-bg transition hover:bg-brass-bright"
        >
          {site.email}
          <span aria-hidden="true">→</span>
        </a>
        <CopyEmail />
        {
          site.cv && (
            <a
              href={site.cv}
              download
              class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-medium transition hover:border-brass hover:text-brass"
            >
              Download CV
              <span aria-hidden="true">↓</span>
            </a>
          )
        }
      </div>
    </div>
  </section>
</Base>

<script>
  const bar = document.getElementById("work-filters");
  const grid = document.getElementById("work-grid");
  const count = document.getElementById("work-count");

  if (bar && grid) {
    const cards = [...grid.querySelectorAll<HTMLElement>("[data-stack]")];
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>("[data-filter]")];

    bar.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
      if (!btn) return;
      const tag = btn.dataset.filter ?? "";

      for (const b of buttons) b.setAttribute("aria-pressed", String(b === btn));

      let shown = 0;
      for (const card of cards) {
        const match = !tag || (card.dataset.stack ?? "").split("|").includes(tag);
        card.hidden = !match;
        if (match) {
          shown++;
          // A card revealed by the filter may never have scrolled into view,
          // so it would otherwise stay at opacity 0
          card.classList.add("is-in");
        }
      }
      if (count) count.textContent = `${shown} ${shown === 1 ? "project" : "projects"}`;
    });
  }
</script>
