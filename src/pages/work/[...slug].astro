---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import CopyEmail from "../../components/CopyEmail.astro";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const work = await getCollection("work", ({ data }) => data.published);
  // Same order as the home page: client work first, then personal projects
  const sorted = work.sort(
    (a, b) => Number(a.data.personal) - Number(b.data.personal) || a.data.order - b.data.order,
  );

  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: sorted[(i + 1) % sorted.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const { title, client, role, period, stack, teamSize, summary, href, metrics, decisions } =
  entry.data;

const shots = import.meta.glob<{ default: ImageMetadata }>("/src/assets/work/*.png", {
  eager: true,
});
// More screens go in src/assets/work/<slug>/ and show as a gallery after the
// write-up, in filename order. Nothing to declare in the frontmatter.
const extraShots = import.meta.glob<{ default: ImageMetadata }>("/src/assets/work/*/*.{png,jpg,jpeg,webp}", {
  eager: true,
});
const gallery = Object.entries(extraShots)
  .filter(([path]) => path.startsWith(`/src/assets/work/${entry.id}/`))
  .sort(([a], [b]) => a.localeCompare(b, "en", { numeric: true }))
  .map(([, mod]) => mod.default);

// The cover is the largest paint on the page. It rises in with CSS rather than
// .reveal, which waits for a script before the image may show, and it is fetched
// ahead of the fonts.
const cover = shots[`/src/assets/work/${entry.id}.png`]?.default;

// Link previews use a card drawn for this case study at build time
// (src/pages/og/[slug].jpg.ts): title, client and role on the site's canvas,
// with the screenshot running off the edge when there is one.
const preview = `/og/${entry.id}.jpg`;

const facts = [
  ["Client", client],
  ["Role", role],
  ["Timeline", period],
  teamSize ? ["Team", `${teamSize} people`] : null,
].filter(Boolean) as [string, string][];
---

<Base title={title} description={summary} image={preview} type="article">
  <article>
    <header class="canvas-grid border-b border-border">
      <div class="mx-auto max-w-5xl px-6 pt-12 pb-14">
        <a href="/#work" class="eyebrow transition-colors hover:text-brass">← All work</a>

        <h1
          class="rise mt-6 pb-[0.06em] font-display text-[clamp(2.25rem,6vw,4rem)] leading-[1.05] font-extrabold tracking-[-0.03em]"
        >
          {title}
        </h1>
        <p class="rise mt-5 text-lg leading-relaxed text-muted" style="animation-delay: 120ms">
          {summary}
        </p>

        <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
          {
            facts.map(([k, v]) => (
              <div>
                <dt class="eyebrow">{k}</dt>
                <dd class="mt-1.5 text-sm">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    {
      cover && (
        <div class="mx-auto max-w-5xl px-6">
          <div class="cover-frame rise -mt-8 overflow-hidden rounded-2xl border border-border shadow-2xl shadow-black/20">
            <Image
              src={cover}
              alt={`${title} interface`}
              widths={[640, 1024, 1440]}
              sizes="(min-width: 1024px) 976px, calc(100vw - 48px)"
              class="case-cover w-full"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      )
    }

    {
      metrics && metrics.length > 0 && (
        <div class="mx-auto max-w-5xl px-6 pt-14">
          <dl class="reveal grid grid-cols-2 gap-6 border-y border-border py-8 sm:grid-cols-4">
            {metrics.map((m) => (
              <div>
                <dt class="font-display text-2xl font-extrabold tracking-tight text-brass tabular-nums sm:text-3xl">
                  {m.value}
                </dt>
                <dd class="mt-1.5 text-sm text-muted">{m.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    <div class="mx-auto max-w-5xl px-6 py-16">
      <div class="prose reveal max-w-none">
        <Content />
      </div>

      {
        decisions && decisions.length > 0 && (
          <section class="mt-14" aria-labelledby="decisions-title">
            <h2 id="decisions-title" class="eyebrow reveal text-brass">
              Key decisions
            </h2>
            <ol class="mt-6 grid gap-4 sm:grid-cols-2">
              {decisions.map((d, i) => (
                <li class="reveal rounded-xl border border-border bg-surface p-5">
                  <p class="font-mono text-[11px] text-muted">{String(i + 1).padStart(2, "0")}</p>
                  <h3 class="mt-2 font-display text-base font-bold tracking-tight">{d.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{d.body}</p>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        gallery.length > 0 && (
          <section class="mt-14" aria-labelledby="gallery-title">
            <h2 id="gallery-title" class="eyebrow reveal text-brass">
              More screens
            </h2>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              {gallery.map((shot, i) => (
                <div class="reveal overflow-hidden rounded-xl border border-border">
                  <Image
                    src={shot}
                    alt={`${title}, screen ${i + 2}`}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1024px) 476px, (min-width: 768px) calc(50vw - 36px), calc(100vw - 48px)"
                    class="w-full"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </section>
        )
      }

      <div class="reveal mt-12 flex flex-wrap items-center gap-2">
        {
          stack.map((s) => (
            <span class="rounded-full border border-border px-3 py-1 font-mono text-[11px] text-muted">
              {s}
            </span>
          ))
        }
      </div>

      {
        href && (
          <a
            href={href}
            target="_blank"
            rel="noopener"
            class="reveal mt-8 inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm transition hover:border-brass hover:text-brass"
          >
            {href.startsWith("https://github.com/") ? "View the code" : "Visit the site"}
            <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>

    {/* Next project keeps people moving through the work instead of bouncing */}
    <nav class="border-t border-border" aria-label="Next project">
      <a
        href={`/work/${next.id}/`}
        class="group mx-auto flex max-w-5xl items-center justify-between gap-6 px-6 py-10"
      >
        <div>
          <span class="eyebrow">Next project</span>
          <p
            class="mt-1.5 font-display text-2xl font-bold tracking-tight transition-colors group-hover:text-brass"
          >
            {next.data.title}
          </p>
        </div>
        <span
          class="text-2xl text-muted transition-transform group-hover:translate-x-1 group-hover:text-brass"
          aria-hidden="true">→</span
        >
      </a>
    </nav>

    <section class="mx-auto max-w-5xl px-6 pt-4">
      <div class="reveal rounded-3xl border border-border bg-surface p-10">
        <h2 class="font-display text-2xl font-bold tracking-tight">Curious about the details?</h2>
        <p class="mt-3 text-muted">Happy to talk through how any of this was built.</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 rounded-full bg-brass px-5 py-2.5 text-sm font-medium text-bg transition hover:bg-brass-bright"
          >
            {site.email}
            <span aria-hidden="true">→</span>
          </a>
          <CopyEmail />
        </div>
      </div>
    </section>
  </article>
</Base>
